{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShadowVPN",
  "version": "0.10.0",
  "identifier": "net.shadownet.shadowvpn.desktop",
  "build": { "frontendDist": "../src/renderer" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "ShadowVPN", "width": 900, "height": 560, "minWidth": 720, "minHeight": 460, "resizable": true, "backgroundColor": "#080808" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../bin/shadowvpn-core.exe": "bin/shadowvpn-core.exe", "../bin/wintun.dll": "bin/wintun.dll", "../licenses/": "licenses/" }
  }
}
